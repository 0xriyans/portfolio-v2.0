---
import { SITE, SOCIAL_LINKS } from '../lib/config';
---

<footer class="relative z-10 mt-28 bg-[#050505] py-12 text-[#8E8E93] md:mt-36">
  <div class="mx-auto max-w-[1360px] px-5 sm:px-8 lg:px-12 xl:px-16">
    <div class="flex flex-col justify-between gap-6 pb-8 md:flex-row md:items-end">
      <div class="max-w-md space-y-2">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/[0.06] px-3 py-1 text-[11px] font-semibold tracking-wider text-[#D4D4D8] uppercase">
          <span class="h-1.5 w-1.5 rounded-full bg-white" aria-hidden="true"></span>
          <span>{SITE.status} · {SITE.location}</span>
        </div>
        <p class="text-xl font-semibold tracking-tight text-[#FFFFFF]">{SITE.name}</p>
        <p class="text-sm leading-relaxed text-[#8E8E93]">
          {SITE.role} — designing resilient APIs, distributed systems, and end-to-end products.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        {
          SOCIAL_LINKS.filter(item => item.name === 'GitHub' || item.name === 'LinkedIn' || item.name === 'Email').map(item => (
            <a
              href={item.url}
              target={item.url.startsWith('mailto:') ? undefined : '_blank'}
              rel={item.url.startsWith('mailto:') ? undefined : 'noopener noreferrer'}
              class="rounded-full bg-white/[0.06] px-4 py-1.5 text-xs font-semibold text-[#D4D4D8] transition-colors hover:bg-white/15 hover:text-white"
            >
              {item.name}
            </a>
          ))
        }
        <a
          href={SITE.cvUrl}
          download={SITE.cvFileName}
          class="rounded-full bg-[#FFFFFF] px-4 py-1.5 text-xs font-bold text-[#080808] shadow-md transition-all hover:bg-[#E4E4E7]"
        >
          Resume (PDF)
        </a>
      </div>
    </div>

    <div class="mt-6 flex flex-col items-start justify-between gap-3 text-xs text-[#71717A] sm:flex-row sm:items-center">
      <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
      <p>Built with Astro, Tailwind CSS, Magic UI, Motion, Lottie &amp; Rive</p>
      <a
        href="#hero"
        class="font-semibold text-[#FFFFFF] transition-colors hover:text-[#E4E4E7]"
      >
        Back to top &uarr;
      </a>
    </div>
  </div>
</footer>
